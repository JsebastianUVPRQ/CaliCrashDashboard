    "url": "https://github.com/JsebastianUVPRQ/Vidas-en-la-Via-Atlas-de-Siniestralidad-CaliCrashDashboard/issues"
  },
  "homepage": "https://github.com/JsebastianUVPRQ/Vidas-en-la-Via-Atlas-de-Siniestralidad-CaliCrashDashboard#readme",
  "devDependencies": {
